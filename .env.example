# ─────────────────────────────────────────────
# Orbital CLI — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in every value.
# Never commit your real .env file to Git.
# ─────────────────────────────────────────────

# The port number the backend Express server will listen on.
# 3000 is the default. Change it if another app is already using that port.
PORT=3000

# Your PostgreSQL connection string.
# Get a free hosted database at https://neon.tech — no local install needed.
# Format: postgresql://USER:PASSWORD@HOST/DATABASE
DATABASE_URL="postgresql://user:password@host/dbname"

# A long random secret used to sign authentication tokens.
# Generate one by running:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this value private — treat it like a password.
BETTER_AUTH_SECRET="replace-this-with-a-long-random-string"

# The full URL where your backend server is running.
# Use http://localhost:3000 for local development.
# Update this if you change PORT above.
BETTER_AUTH_URL="http://localhost:3000"

# Your GitHub OAuth App credentials.
# Create an OAuth App at https://github.com/settings/developers
#   - Homepage URL: http://localhost:3000
#   - Authorization callback URL: http://localhost:3000/api/auth/callback/github
# Then copy the Client ID and Client Secret here.
GITHUB_CLIENT_ID="your-github-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-app-client-secret"

# Your Google Gemini API key.
# Get a free key at https://aistudio.google.com/apikey
# The free tier is sufficient for development.
GOOGLE_GENERATIVE_AI_API_KEY="your-google-gemini-api-key"
ORBITAL_MODEL_PROVIDER=gemini

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI
OPENAI_API_KEY=your_openai_key_here

# (Optional) The Gemini model to use.
# Leave blank to use the default: gemini-2.5-flash
# Other options: gemini-1.5-pro, gemini-1.5-flash
ORBITAI_MODEL=""
